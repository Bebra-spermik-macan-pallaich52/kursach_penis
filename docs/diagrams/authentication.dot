digraph G {
 graph[rankdir=TB,bgcolor="white",pad=.2];node[shape=box,fontname="DejaVu Sans",fontsize=13];edge[fontname="DejaVu Sans",fontsize=11];
 a[shape=oval,label="Защищённый запрос"];b[label="Получить Authorization: Bearer"];
 c[shape=diamond,label="Подпись HS256, exp, iat,\nsub, ver корректны?"];
 d[label="Прочитать пользователя из PostgreSQL"];
 e[shape=diamond,label="Активен и token_version\nсовпадает с ver?"];
 f[shape=diamond,label="Роль и принадлежность\nдают право на операцию?"];
 g[shape=oval,label="Выполнить операцию"];h[shape=oval,label="401: повторный вход"];i[shape=oval,label="403: нет прав"];
 a->b;b->c;c->h[label="нет"];c->d[label="да"];d->e;e->h[label="нет"];e->f[label="да"];f->i[label="нет"];f->g[label="да"];
}