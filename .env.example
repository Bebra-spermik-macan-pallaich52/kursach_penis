# Пароли ниже предназначены только для локальной учебной базы.
DATABASE_URL=postgresql+psycopg://olympiad:olympiad_local@localhost:5432/olympiads
TEST_DATABASE_URL=postgresql+psycopg://olympiad:olympiad_local@localhost:5432/olympiads_test
# python scripts/configure.py создаст случайный ключ в .env
JWT_SECRET=GENERATE_WITH_CONFIGURE_SCRIPT
TOKEN_MINUTES=60
ADMIN_USERNAME=admin
# Заменить для базы без демонстрационных данных.
ADMIN_PASSWORD=ChangeThisAdmin2026!

